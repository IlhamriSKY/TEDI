{
  "name": "tedi",
  "private": true,
  "version": "0.3.10",
  "description": "TEDI - Terminal Environment & Development Infrastructure. A lightweight terminal with split screens, tab grouping, and workspaces.",
  "author": "IlhamriSKY",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/IlhamriSKY/TEDI.git"
