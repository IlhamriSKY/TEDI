{
  "name": "tedi",
  "private": true,
  "version": "0.4.14",
  "description": "TEDI - Terminal Director. A lightweight terminal with split screens, tab grouping, and workspaces.",
  "author": "IlhamriSKY",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/IlhamriSKY/TEDI.git"
  },
  "homepage": "https://github.com/IlhamriSKY/TEDI",
  "bugs": {
    "url": "https://github.com/IlhamriSKY/TEDI/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "tauri:dev:ext": "node scripts/link-dev-extensions.mjs && pnpm tauri:dev",
    "link:ext": "node scripts/link-dev-extensions.mjs",
    "relink:ext": "node scripts/link-dev-extensions.mjs --force",
    "unlink:ext": "node scripts/link-dev-extensions.mjs --unlink",
    "typecheck": "tsc --noEmit",
    "lint:imports": "node scripts/check-imports.mjs",
    "verify": "node scripts/verify-all.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,css,json,md}\" \"*.{ts,tsx,js,jsx,css,json,md,html}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,css,json,md}\" \"*.{ts,tsx,js,jsx,css,json,md,html}\"",
    "lint:rust": "cd src-tauri && cargo fmt --all -- --check && cargo clippy --all-targets -- -D warnings",
    "fmt:rust": "cd src-tauri && cargo fmt --all",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.81",
    "@ai-sdk/cerebras": "^2.0.54",
    "@ai-sdk/google": "^3.0.80",
    "@ai-sdk/groq": "^3.0.39",
    "@ai-sdk/openai": "^3.0.67",
    "@ai-sdk/openai-compatible": "^2.0.48",
    "@ai-sdk/react": "^3.0.195",
    "@ai-sdk/xai": "^3.0.93",
    "@codemirror/autocomplete": "^6.20.2",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/language": "^6.12.3",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/lint": "^6.9.6",
    "@codemirror/merge": "^6.12.1",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@iconify-json/catppuccin": "^1.2.17",
    "@lezer/highlight": "^1.2.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
